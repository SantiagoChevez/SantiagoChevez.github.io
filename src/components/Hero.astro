---
// src/components/Hero.astro
const { lang = 'en' } = Astro.props;

const content = {
  en: {
    badge: "Open to Software Engineering Roles",
    greeting: "Hi, I'm",
    title: "Software Engineer | AI, Robotics & Cybersecurity",
    bio: "Computer Engineering graduate with Honors from Tec de Monterrey. Passionate about building high-impact software solutions, leading engineering teams, and developing AI-driven applications and robotics systems.",
    cv: "Download CV",
    cvLink: "/Santiago Chevez Trejo English 2026.pdf",
    cvFileName: "CV_Santiago_Chevez_EN.pdf"
  },
  es: {
    badge: "Disponible para Roles de Ingeniería de Software",
    greeting: "Hola, soy",
    title: "Ingeniero de Software | IA, Robótica y Ciberseguridad",
    bio: "Graduado con Mención Honorífica de Ingeniería en Computación del Tec de Monterrey. Apasionado por construir soluciones de software de alto impacto, liderar equipos de ingeniería y desarrollar aplicaciones impulsadas por IA y sistemas robóticos.",
    cv: "Descargar CV",
    cvLink: "Santiago Chevez Trejo 2026.pdf",
    cvFileName: "CV_Santiago_Chevez_ES.pdf"
  }
};

const t = content[lang] || content.en;
---

<section class="min-h-[75vh] flex flex-col justify-center items-start max-w-4xl mx-auto px-6 py-12">
  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-medium mb-6">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
    </span>
    {t.badge}
  </div>

  <h1 class="text-4xl sm:text-6xl font-bold text-white tracking-tight mb-4">
    {t.greeting} <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">Santiago Chevez</span>
  </h1>

  <h2 class="text-xl sm:text-2xl font-medium text-slate-300 mb-6">
    {t.title}
  </h2>

  <p class="text-slate-400 text-lg leading-relaxed max-w-2xl mb-8">
    {t.bio}
  </p>

  <div class="flex flex-wrap gap-4 items-center">
    <a 
      href={t.cvLink} 
      download={t.cvFileName}
      target="_blank"
      class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-all duration-200 shadow-lg shadow-blue-500/20 flex items-center gap-2"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      {t.cv}
    </a>

    <a 
      href="https://github.com/SantiagoChevez" 
      target="_blank"
      class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold transition-all duration-200 flex items-center gap-2"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      GitHub
    </a>

    <a 
      href="https://www.linkedin.com/in/santiago-chevez-trejo-199340249/" 
      target="_blank"
      class="p-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all duration-200"
      aria-label="LinkedIn"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
      </svg>
    </a>
  </div>
</section>